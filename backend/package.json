{
  "name": "ai-xandria-backend",
  "version": "2.0.0",
  "description": "AI_XANDRIA v2.0 Backend - AWS Lambda + Express + Bedrock",
  "type": "module",
  "scripts": {
    "dev": "serverless offline start",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage production",
    "remove": "serverless remove",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "node -r dotenv/config ./src/config/database.js migrate",
    "db:seed": "node -r dotenv/config ./src/config/database.js seed",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "express": "^4.18.2",
    "serverless-http": "^3.2.0",
    "serverless-offline": "^12.0.4",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "sequelize": "^6.33.0",
    "@aws-sdk/client-bedrock-runtime": "^3.398.0",
    "@aws-sdk/client-s3": "^3.398.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.398.0",
    "axios": "^1.5.0",
    "ethers": "^6.7.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "rate-limiter-flexible": "^4.0.1",
    "uuid": "^9.0.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "eslint": "^8.48.0",
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
