# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Amazon Bedrock Configuration
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_IMAGE_MODEL=amazon.titan-image-generator-v1

# Database Configuration (Amazon RDS PostgreSQL)
RDS_HOST=your-rds-instance.region.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=ai_xandria
RDS_USERNAME=postgres
RDS_PASSWORD=your_secure_password_here

# JWT & Security
JWT_SECRET=your_jwt_secret_min_32_chars_here
CRYPTO_KEY=your_crypto_key_32_chars_here

# IPFS Configuration (Pinata)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt
PINATA_GATEWAY=https://gateway.pinata.cloud

# Blockchain Configuration (Somnia)
SOMNIA_RPC_URL=https://rpc.somnia.network
CONTRACT_ADDRESS=0xd9145CCE52D386f254917e481eB44e9943F39138
MARKETPLACE_ADDRESS=0x...
ARENA_ADDRESS=0x...

# S3 Bucket Names
S3_PERSONAS_BUCKET=ai-xandria-dev-personas
S3_NFTS_BUCKET=ai-xandria-dev-nfts
S3_BATTLES_BUCKET=ai-xandria-dev-battles

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Development
NODE_ENV=development
LOG_LEVEL=info
DEBUG=false

# Fallback AI Services (Optional)
DEEPSEEK_API_KEY=your_deepseek_key_optional
GEMINI_API_KEY=your_gemini_key_optional
FREEPIK_API_KEY=your_freepik_key_optional
