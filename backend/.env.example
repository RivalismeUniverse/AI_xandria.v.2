# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
BEDROCK_REGION=us-east-1

# Database (Amazon RDS PostgreSQL)
RDS_HOST=your-rds-instance.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=aixandria
RDS_USERNAME=postgres
RDS_PASSWORD=your_secure_password

# VPC Configuration (for Lambda)
VPC_SECURITY_GROUP_ID=sg-xxxxxxxxx
VPC_SUBNET_ID_1=subnet-xxxxxxxxx
VPC_SUBNET_ID_2=subnet-yyyyyyyyy

# S3 Storage
S3_BUCKET=ai-xandria-metadata

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Blockchain (Somnia Network)
BLOCKCHAIN_RPC=https://rpc.somnia.network/testnet
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
MARKETPLACE_CONTRACT=0x0000000000000000000000000000000000000000
PRIVATE_KEY=your_deployer_private_key

# API Configuration
PORT=3000
NODE_ENV=development

# Frontend Configuration
VITE_API_URL=http://localhost:3000
VITE_BLOCKCHAIN_RPC=https://rpc.somnia.network/testnet
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MARKETPLACE_CONTRACT=0x0000000000000000000000000000000000000000
